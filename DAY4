class Main {
    public static void main(String[] args) {

        StringBuffer a = new StringBuffer("hello");

        System.out.println(a);

        a.append("janu");
        System.out.println(a);

        a.insert(5, "goparam");
        System.out.println(a);

        a.replace(5, 12, "JAVA");
        System.out.println(a);

        a.delete(0, 4);
        System.out.println(a);

        a.deleteCharAt(4);
        System.out.println(a);

        a.reverse();
        System.out.println(a);

        System.out.println(a.capacity());

        System.out.println(a.charAt(0));

        a.setCharAt(1, 'H');
        System.out.println(a);

        System.out.println(a.toString());
    }
}





