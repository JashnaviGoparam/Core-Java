             System.out.println(s.split(""));
             System.out.println(s.compareToIgnoreCase("janu"));
         System.out.println(s.compareTo("janu"));
         System.out.println(s.equals("janu"));
         System.out.println(s.equalsIgnoreCase("janu"));
         System.out.println(s.isEmpty());
         System.out.println(s.replaceALL("janu","JANU"));
